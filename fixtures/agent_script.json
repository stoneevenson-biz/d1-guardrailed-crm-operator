    {"do": "call", "tool": "crm.get_contact", "args": {"contact_id": 4}, "why": "read the next lead"},
    {"do": "call", "tool": "sms.send", "args": {"contact_id": 4, "body": "Flash sale, 50% off, reply YES"},
